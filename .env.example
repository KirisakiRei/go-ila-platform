# ============================================================================
# ILA Platform — contoh konfigurasi environment
# Salin menjadi .env lalu isi nilainya. File .env TIDAK boleh di-commit.
# ============================================================================

APP_ENV=development
LOG_LEVEL=info
HTTP_PORT=8080
PUBLIC_BASE_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# DB_DSN menyusun ulang dirinya dari DB_USER/DB_PASSWORD/DB_NAME di bawah;
# jangan tulis ulang di sini agar password tidak pernah berbeda antar layanan.
DB_DSN=
DB_NAME=ila
DB_USER=ila
DB_PASSWORD=ubah-password-ini
DB_MAX_IDLE_CONNS=5
DB_MAX_OPEN_CONNS=20
DB_CONN_MAX_LIFETIME=1h
DB_AUTO_MIGRATE=false

# --- Sesi -------------------------------------------------------------------
# Wajib minimal 32 karakter. Buat dengan: openssl rand -hex 32
JWT_SECRET=ganti-dengan-32-byte-acak
JWT_EXPIRY=12h
# --- Cookie Sesi ------------------------------------------------------------
# Sesi disimpan di cookie HttpOnly; token tidak pernah sampai ke JavaScript.
SESSION_COOKIE_NAME=ila_session
CSRF_COOKIE_NAME=ila_csrf
# Sesi admin terpisah dari sesi user dan lebih pendek umurnya.
ADMIN_COOKIE_NAME=ila_admin_session
ADMIN_CSRF_COOKIE_NAME=ila_admin_csrf
ADMIN_JWT_EXPIRY=2h
# Batas diam yang memicu modal "masih di sini?" di panel admin.
ADMIN_IDLE_TIMEOUT=10m
# WAJIB true di produksi (wajib HTTPS). Biarkan false hanya untuk localhost.
COOKIE_SECURE=false
# Kosongkan untuk host-only cookie.
COOKIE_DOMAIN=

# --- CORS -------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000

# --- Engine (VPS 1) ---------------------------------------------------------
# Koneksi dibuka dari platform KE engine, bukan sebaliknya.
ENGINE_GRPC_ADDR=engine.internal:9090
ENGINE_MTLS_CERT=/certs/runner-client.crt
ENGINE_MTLS_KEY=/certs/runner-client.key
ENGINE_MTLS_CA=/certs/ca.crt
# Nama di SAN sertifikat engine bila berbeda dari host dial.
ENGINE_SERVER_NAME=
# Strategi yang dilayani alamat di atas: ila-2.0 atau ila-3.0.
ENGINE_STRATEGY=ila-2.0
RUNNER_SUBSCRIBER_ID=runner-1

# --- Engine ILA 3.0 (proses terpisah) --------------------------------------
# Kosongkan bila engine ILA 3.0 belum dijalankan. Kontrak gRPC-nya sama.
ENGINE3_GRPC_ADDR=
ENGINE3_MTLS_CERT=
ENGINE3_MTLS_KEY=
ENGINE3_MTLS_CA=
ENGINE3_SERVER_NAME=
# Tahap ketersediaan ILA 3.0: off | internal | beta | general.
# Saat off, engine ILA 3.0 tidak dijalankan dan user melihat "Coming Soon".
ILA3_AVAILABILITY=off

# --- Aturan harian ----------------------------------------------------------
# Hari dihitung dalam WIB; sesi pasar tetap mengikuti NY/UTC.
DAILY_TZ=Asia/Jakarta
MAX_DAILY_TRADES=2
MAX_DAILY_LOSSES=2
STOP_AFTER_WIN=true

# --- Eksekusi ---------------------------------------------------------------
# AUTO_EXECUTE=false berarti semua akun diperlakukan manual, apa pun mode akun.
AUTO_EXECUTE=false
# DRY_RUN_ALL=true memaksa seluruh eksekusi menjadi simulasi tanpa broker.
DRY_RUN_ALL=false

# --- Kredensial broker ------------------------------------------------------
# Kunci master 32 byte base64. Buat dengan: openssl rand -base64 32
# Kunci ini TIDAK boleh ikut backup database dan tidak boleh di-commit.
# Kunci master membungkus kredensial broker DAN secret 2FA.
# Tanpa nilai sah: endpoint akun dinonaktifkan dan 2FA tidak tersedia.
MASTER_KEY=
MASTER_KEY_VERSION=1
# Kunci lama saat rotasi, format "<versi>:<base64>,<versi>:<base64>".
# Kosongkan bila belum pernah merotasi. Hapus entri setelah semua blob
# lama ditulis ulang dengan kunci baru.
MASTER_KEYS_LEGACY=

# --- Pembayaran --------------------------------------------------------------
# Penyedia pembayaran aktif: pakasir | manual.
# manual = tidak ada penyedia daring; tagihan hanya bisa ditutup lewat
# catatan pembayaran manual oleh admin. Cocok bila penyedia berhenti.
PAYMENT_PROVIDER=pakasir
PAYASIR_SLUG=
PAYASIR_API_KEY=
PAYASIR_BASE_URL=https://pakasir.com

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Tanpa @. Dipakai membentuk tautan t.me untuk menghubungkan chat.
TELEGRAM_BOT_USERNAME=
# Rahasia header X-Telegram-Bot-Api-Secret-Token pada webhook.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_TIMEOUT=10s
# Chat ID admin penerima peringatan operasional (engine putus, broker error,
# disk penuh). Kosong berarti peringatan dimatikan; sistem tetap berjalan.
TELEGRAM_ADMIN_CHAT_ID=

# --- SMTP (antrean surel: verifikasi email & reset kata sandi) --------------
# Kosong berarti surel menumpuk di tabel email_outbox, bukan hilang.
# SMTP_HOST dan SMTP_FROM harus diisi bersama; proses menolak start bila hanya
# salah satu terisi.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ILA Bot <no-reply@contoh.id>
