# ============================================================================
# ILA Platform — contoh konfigurasi environment
# Salin menjadi .env lalu isi nilainya. File .env TIDAK boleh di-commit.
# ============================================================================

APP_ENV=development
LOG_LEVEL=info
HTTP_PORT=8080
PUBLIC_BASE_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
DB_DSN=postgres://ila:ubah-password-ini@postgres:5432/ila?sslmode=disable
DB_NAME=ila
DB_USER=ila
DB_PASSWORD=ubah-password-ini
DB_MAX_IDLE_CONNS=5
DB_MAX_OPEN_CONNS=20
DB_CONN_MAX_LIFETIME=1h
DB_AUTO_MIGRATE=false

# --- Sesi -------------------------------------------------------------------
# Wajib minimal 32 karakter. Buat dengan: openssl rand -hex 32
JWT_SECRET=ganti-dengan-32-byte-acak
JWT_EXPIRY=12h

# --- CORS -------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000

# --- Engine (VPS 1) ---------------------------------------------------------
# Koneksi dibuka dari platform KE engine, bukan sebaliknya.
ENGINE_GRPC_ADDR=engine.internal:9090
ENGINE_MTLS_CERT=/certs/runner-client.crt
ENGINE_MTLS_KEY=/certs/runner-client.key
ENGINE_MTLS_CA=/certs/ca.crt

# --- Aturan harian ----------------------------------------------------------
DAILY_TZ=Asia/Jakarta
MAX_DAILY_TRADES=2
STOP_AFTER_WIN=true

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_TIMEOUT=10s
