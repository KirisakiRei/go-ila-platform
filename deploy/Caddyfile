# Satu-satunya pintu masuk publik untuk ILA Platform.
#
# Frontend dan API berada di origin yang sama. Cookie sesi memakai
# SameSite=Strict, jadi keduanya WAJIB satu domain: kalau dipisah,
# deep-link konfirmasi dari Telegram akan kehilangan sesi.
#
# Urutan `handle` penting: Caddy memakai blok pertama yang cocok, sehingga
# path paling spesifik harus ditulis lebih dulu.
#
# Catatan: email ACME sengaja TIDAK ditulis di sini. Blok global `email`
# menolak nilai kosong dan membuat Caddy gagal start, sehingga email didaftarkan
# lewat direktif `tls` di blok situs yang hanya aktif bila nilainya terisi.

# ---------------------------------------------------------------------------
# Log akses HTTP.
#
# Akses ditulis di Caddy, bukan di backend-api: proxy adalah satu-satunya yang
# melihat semua permintaan, termasuk yang tidak sampai ke aplikasi.
# Format JSON agar bisa di-query dengan jq seperti log layanan lain.
#
# Berkas dikelompokkan ke folder tanggal oleh Caddy sendiri
# (output file dengan roll_*), sehingga akses HTTP tetap terbaca per hari.
# ---------------------------------------------------------------------------
{
	log default {
		output file /var/log/ila/caddy.log {
			roll_size 10mb
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}
}

{$SITE_ADDRESS:localhost}, www.{$SITE_ADDRESS} {
	# www ikut didaftarkan di alamat situs, bukan hanya di `redir`: TLS handshake
	# terjadi sebelum aturan redirect, jadi tanpa nama itu sertifikat untuk www
	# tidak pernah diterbitkan dan browser menolak koneksi.
	#
	# `tls` cukup menuliskan email ACME. Bila ACME_EMAIL kosong (pengembangan),
	# Caddy memakai sertifikat internal dan tidak menunggu penerbitan.
	# Blok kondisional tidak dipakai karena nilai default kosong `{$VAR:}`
	# diteruskan mentah oleh Caddy dan membuat berkas ini gagal di-parse.
	tls {$ACME_EMAIL:internal}

	# www diarahkan permanen ke domain utama agar cookie sesi tidak terbagi
	# ke dua host dan tautan yang dibagikan selalu satu bentuk.
	@www host www.{$SITE_ADDRESS}
	redir @www https://{$SITE_ADDRESS}{uri} permanent

	# Kompresi untuk aset teks.
	encode zstd gzip

	# --- API -----------------------------------------------------------------
	# Prefix sudah sama dengan yang dipakai backend (/api/v1), jadi tidak ada
	# penulisan ulang path.
	handle /api/* {
		reverse_proxy backend-api:8080
	}

	handle /health {
		reverse_proxy backend-api:8080
	}

	handle /ready {
		reverse_proxy backend-api:8080
	}

	# --- Frontend ------------------------------------------------------------
	# SPA: semua path lain disajikan Nginx, yang punya fallback ke index.html.
	handle {
		reverse_proxy frontend:3000
	}

	# Header keamanan tingkat situs.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		# Versi server tidak perlu dibocorkan.
		-Server
	}

	# Versi:
	# - Cookie, Authorization, dan Set-Cookie disamarkan sebelum ditulis.
	#   Tanpa ini, siapa pun yang bisa membaca berkas log dapat membajak sesi.
	# - X-Request-ID dibiarkan agar log Caddy bisa disambung ke log backend-api.
	log {
		format filter {
			wrap json
			request>headers>Cookie delete
			request>headers>Authorization delete
			response>headers>Set-Cookie delete
		}
	}

	# Ukuran badan permintaan dibatasi agar tidak ada unggahan tak terduga.
	request_body {
		max_size 1MB
	}
}
