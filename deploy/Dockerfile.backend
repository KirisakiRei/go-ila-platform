# syntax=docker/dockerfile:1

# Build stage
FROM golang:1.24-alpine AS builder

WORKDIR /src

RUN apk add --no-cache git ca-certificates

COPY backend/go.mod backend/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY backend/ ./

# Dua binary dari satu modul: backend-api (HTTP), runner (eksekusi), migrate.
#
# -p=1 membatasi one compile task at a time. Di VPS 2 vCPU / RAM 909 MB,
# kompilasi paralel menghabiskan RAM sampai swap dan justru jauh lebih lambat.
# Cache mount dipakai agar unduhan modul tidak diulang tiap build.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux GOFLAGS=-p=1 \
    go build -trimpath -ldflags="-s -w" -o /out/backend-api ./cmd/backend-api \
 && CGO_ENABLED=0 GOOS=linux GOFLAGS=-p=1 \
    go build -trimpath -ldflags="-s -w" -o /out/runner ./cmd/runner \
 && CGO_ENABLED=0 GOOS=linux GOFLAGS=-p=1 \
    go build -trimpath -ldflags="-s -w" -o /out/migrate ./cmd/migrate  && CGO_ENABLED=0 GOOS=linux GOFLAGS=-p=1     go build -trimpath -ldflags="-s -w" -o /out/seed-superadmin ./cmd/seed-superadmin

# Runtime stage
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata wget \
 && addgroup -S -g 1001 app && adduser -S -G app -u 1001 app

# UID/GID tetap agar folder log di host bisa diberi izin yang tepat.
# Dengan UID acak, chown di host tidak bisa diprediksi.

WORKDIR /app

COPY --from=builder /out/backend-api /out/runner /out/migrate /out/seed-superadmin /app/

USER app

EXPOSE 8080

ENTRYPOINT ["/app/backend-api"]
